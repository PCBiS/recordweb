# syntax=docker/dockerfile:1
ARG TARGETARCH
# Keep the existing reviewed AMD64 dependency/CA image.
FROM ghcr.io/pcbis/recordweb@sha256:17d31a3fa2c0451ac95c4d84a07949153aab9be9874d397ed6c6f9d03a36b981 AS dependency-amd64

# Reuse the original ARM64 build and apply the same CA policy offline.
FROM ghcr.io/pcbis/recordweb@sha256:bf809b256434aa8536d19b5092024b926ed3257b52783c6fcb310c2b323f750a AS dependency-arm64
RUN --network=none \
    --mount=type=bind,source=security/ca_policy.py,target=/tmp/ca_policy.py,ro \
    python3 -I -B /tmp/ca_policy.py apply

# Insert after dependency-amd64 / dependency-arm64 definitions and before supported.
FROM dependency-${TARGETARCH} AS ffmpeg9-build
ARG TARGETARCH
ARG FFMPEG_BUILD_JOBS=2
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i -e 's|http://deb.debian.org|https://deb.debian.org|g' \
           -e 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential dpkg-dev python3 ca-certificates libharfbuzz-dev \
 && apt-get build-dep -y --no-install-recommends ffmpeg=7:5.1.9-0+deb12u1
COPY ffmpeg9/build.py /opt/ffmpeg9-build/build.py
RUN --mount=type=cache,id=recordweb-ffmpeg9-source-${TARGETARCH},target=/opt/ffmpeg9-build/work \
    python3 /opt/ffmpeg9-build/build.py build

FROM dependency-${TARGETARCH} AS ffmpeg9-runtime
COPY --from=ffmpeg9-build /opt/recordweb/ffmpeg-9.0.2/ /opt/recordweb/ffmpeg-9.0.2/
COPY --from=ffmpeg9-build /opt/ffmpeg9-build/runtime-packages.json /opt/recordweb/ffmpeg-9.0.2/runtime-packages.json
COPY ffmpeg9/install-runtime.py /opt/recordweb/ffmpeg-9.0.2/install-runtime.py
RUN python3 /opt/recordweb/ffmpeg-9.0.2/install-runtime.py

FROM ffmpeg9-runtime AS ffmpeg9-verified
COPY ffmpeg9/test-child-playlists.py /opt/recordweb/ffmpeg-9.0.2/test-child-playlists.py
RUN --network=none python3 /opt/recordweb/ffmpeg-9.0.2/test-child-playlists.py --expect fixed

FROM ffmpeg9-verified AS supported

COPY security/requirements.runtime.txt /app/requirements.txt
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade \
       libbrotli1=1.0.9-2+deb12u1 libssl3=3.0.22-1~deb12u2 openssl=3.0.22-1~deb12u2 \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --only-binary=:all: pip==26.2 \
    && python -m pip install --no-cache-dir --only-binary=:all: -r /app/requirements.txt \
    && python -m pip check

COPY upstream/ /opt/recordweb-upstream/
COPY patches/ /opt/recordweb-patches/
COPY docker_support/ /opt/recordweb-docker/docker_support/
RUN python /opt/recordweb-docker/docker_support/compose_source.py \
      --upstream /opt/recordweb-upstream --output /tmp/recordweb-execution \
      --baseline /opt/recordweb-patches/upstream.json --patches /opt/recordweb-patches/public.json \
    && cp -a /tmp/recordweb-execution/. /app/ \
    && rm -r /tmp/recordweb-execution \
    && chmod 755 /opt/recordweb-docker/docker_support/entrypoint.sh

FROM supported AS regression
COPY tests/ /app/tests/
COPY upstream/ /app/upstream/
COPY patches/ /app/patches/
COPY docker_support/ /app/docker_support/
RUN --network=none REPLAY_TEST_REAL_FFMPEG=/usr/bin/ffmpeg REPLAY_TEST_UPSTREAM=/app/upstream/module/replay_download.py python -B -m unittest discover -s tests -p 'test_*.py' -v


RUN --network=none --mount=type=bind,source=security/verify_dependency_patch.py,target=/tmp/verify_deps.py,ro \
    python -B /tmp/verify_deps.py
RUN --network=none --mount=type=bind,source=security/verify_ffmpeg_application.py,target=/tmp/verify_media.py,ro \
    RUNTIME_SOURCE=/app python -B /tmp/verify_media.py
RUN --network=none --mount=type=bind,source=security/ca_policy.py,target=/tmp/ca_policy.py,ro \
    python -I -B /tmp/ca_policy.py verify

FROM supported AS runtime
COPY --from=regression /app/docker-build-manifest.json /app/docker-build-manifest.json
ARG SOURCE_REVISION
ENV RECORDWEB_REPLAY_ENABLED=1 \
    RECORDWEB_REPLAY_STATE_DIR=/app/json/replay \
    RECORDWEB_REPLAY_DOWNLOAD_ROOT=/recordings/replay \
    RECORDWEB_LOG_DIR=/var/log/recordweb \
    PYTHONFAULTHANDLER=1
LABEL org.opencontainers.image.version="1.2.9-deps-20261108" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
VOLUME ["/var/log/recordweb"]
ENTRYPOINT ["/opt/recordweb-docker/docker_support/entrypoint.sh"]
CMD ["python", "recordWEB.py"]
